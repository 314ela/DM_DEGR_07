<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--  Textos  -->
    <style name="UpiizPet.Titulo" parent="">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:fontFamily">@font/quicksand</item>
    </style>

    <style name="UpiizPet.Subtitulo" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_gris</item>
        <item name="android:fontFamily">@font/quicksand</item>
    </style>

    <style name="UpiizPet.Usuario" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/coral</item>
        <item name="android:fontFamily">@font/quicksand</item>
    </style>


    <style name="Widget.UpiizPet.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/coral</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="hintTextColor">@color/coral</item>
        <item name="startIconTint">@color/coral</item>
        <item name="endIconTint">@color/texto_gris</item>
    </style>

    <!-- Botones -->
    <style name="Widget.UpiizPet.Button.Primario" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/coral</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:minHeight">58dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="Widget.UpiizPet.Button.Secundario" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/gris_boton</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:minHeight">58dp</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.UpiizPet.Button.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/coral</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/coral</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/quicksand</item>
        <item name="android:minHeight">58dp</item>
        <item name="cornerRadius">18dp</item>
    </style>


    <style name="Widget.UpiizPet.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">3dp</item>
    </style>
</resources>
